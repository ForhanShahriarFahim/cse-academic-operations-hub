# Optional in local development. When omitted, the app uses a persistent
# embedded PGlite database under .data/pglite and seeds it on first `npm run dev`.
# Leave unset for the persistent local PGlite database. Set for PostgreSQL/Vercel.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required to enable invited Google sign-in (use the exact origin of this app).
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-oauth-web-client-secret

# Used only when manually running `npm run auth:bootstrap`.
# PORTAL_BOOTSTRAP_ADMIN_EMAIL=dfahim432@gmail.com
# PORTAL_BOOTSTRAP_ADMIN_NAME=Forhan Shahriar Fahim
